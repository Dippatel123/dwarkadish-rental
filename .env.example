# Gmail SMTP - used to email new contact-form inquiries
# GMAIL_USER: the Gmail address to send from
# GMAIL_APP_PASSWORD: a 16-character App Password (not your normal Gmail password)
#   Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: where inquiry emails are sent. Defaults to GMAIL_USER if left blank.
CONTACT_TO_EMAIL=
